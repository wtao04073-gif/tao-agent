# ── 模型服务 ──────────────────────────────────────────
# 二选一：公有云模型 API，或内网自建推理服务。

# 公有云示例（按实际服务商填写其中一个）
#   DeepSeek   https://api.deepseek.com
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode
#   Kimi       https://api.moonshot.cn
#   豆包        https://ark.cn-beijing.volces.com/api/v3
MODEL_BASE_URL=https://api.deepseek.com

# API Key。**必填**，且不要提交到版本库。
# 本文件是示例（.env.example），真实的 .env 已在 .gitignore 里。
MODEL_API_KEY=

# 模型名。按服务商的模型清单填写。
MODEL_NAME=deepseek-chat

# ── 模型单价（元 / 百万 token）────────────────────────────
# 按服务商价格页填，可带小数。留空则用量只统计 token，
# 看板上的金额恒为 0，模型会被列进「未配价」。
#
# 二选一：要么配单价 + QUOTA_MAX_COST_YUAN 按金额限量，
# 要么两个都留空、改用 QUOTA_MAX_TOKENS 按 token 限量。
# 只配 QUOTA_MAX_COST_YUAN 不配单价，服务会拒绝启动 ——
# 那种组合下金额熔断永远不触发，会静默超卖。
# MODEL_INPUT_PRICE=2
# MODEL_OUTPUT_PRICE=8

# 缓存命中的输入单价。留空时按 MODEL_INPUT_PRICE 计。
# 多数服务商的缓存读价远低于普通输入，配上才算得准。
# MODEL_CACHE_READ_PRICE=0.5

# ── 轻量档模型（可选，M5-5）──────────────────────────────
# 规划/裁决走上面的旗舰档；常规执行与并行子任务可用更便宜的轻量档。
# 三项要么全部填写以启用，要么全部留空（留空则所有任务都走旗舰模型）。
# 只配一部分服务会拒绝启动，避免「以为省了钱、实际仍走旗舰」。
# MODEL_LITE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# MODEL_LITE_API_KEY=

# 轻量档模型名必须与 MODEL_NAME 不同：两档同名时价格表会互相覆盖，
# 服务直接拒绝启动。不想要轻量档就把这三行都留空（回落旗舰）。
# MODEL_LITE_NAME=qwen-turbo
# 轻量档单价（元 / 百万 token）。若上面启用了金额配额
# （QUOTA_MAX_COST_YUAN），轻量档单价也必须配齐，否则拒绝启动。
# MODEL_LITE_INPUT_PRICE=0.3
# MODEL_LITE_OUTPUT_PRICE=2
# MODEL_LITE_CACHE_READ_PRICE=0.2

# ── 数据不出网（离线部署）──────────────────────────────
# 若客户要求数据不出本地网络，把 MODEL_BASE_URL 指向内网推理服务，
# 例如 vLLM / Ollama / 自建推理网关：
#   MODEL_BASE_URL=http://192.168.1.100:8000/v1
#   MODEL_API_KEY=任意非空值（多数自建服务不校验）
# 此时容器不需要出网权限。

# ── 服务 ─────────────────────────────────────────────
# 对外端口。被占用时改这里（自检脚本会提示）。
PORT=8080

# 工作区目录（容器内路径）。产物、知识库、会话数据都在这里。
# 对应的宿主目录在 docker-compose.yml 的 volumes 里配置。
WORKSPACE_DIR=/data/workspace

# ── 资源上限 ─────────────────────────────────────────
# 并发任务数上限。
#
# 每个任务会占用一个模型连接与约 200-400MB 内存。
# 建议值：min(CPU 核数 - 1, 可用内存GB / 1)。
# 8GB 内存 / 4 核的机器填 3 比较稳妥。
# 填太高的后果是撞模型服务的速率限制，或被 OOM kill。
MAX_CONCURRENT_TASKS=3

# 单个任务的子任务并发上限（多部门汇总这类场景会用到）。
# 与 MAX_CONCURRENT_TASKS 相乘才是真实的模型并发数，别都填大。
MAX_SUBTASK_CONCURRENCY=3

# ── 配额（SaaS 形态才需要）──────────────────────────────
# 私有化部署通常不限量，留空即为无限制。
#
# 注意：0 表示「禁用」而非「无限制」——
# 想要无限制请留空或注释掉，不要填 0。
#
# QUOTA_MAX_COST_YUAN 依赖上面的模型单价才能生效，
# 只填这一项而不配单价，服务会拒绝启动。
# QUOTA_MAX_TOKENS=
# QUOTA_MAX_COST_YUAN=
# QUOTA_MAX_TASKS=

# ── 日志 ─────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
