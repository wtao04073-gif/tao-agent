
# 隔离执行：默认关闭；生产使用独立 CubeSandbox VM，在后台填写地址、模板和密钥。
SANDBOX_ENABLED=false
SANDBOX_PROVIDER=cube
SANDBOX_NETWORK_ENABLED=false
SANDBOX_REQUIRE_CONFIRM=true
SANDBOX_TTL_SECONDS=600
SANDBOX_EXEC_TIMEOUT_SECONDS=60
SANDBOX_MAX_CONCURRENT=2
# 本地试用安装后由部署层配置，后台不可修改宿主目录。
# SANDBOX_LOCAL_RUNTIME=/opt/tao-sandbox/venv
# SANDBOX_LOCAL_BROWSERS=/opt/tao-sandbox/browsers
# SANDBOX_LOCAL_UID=62000
# Cube 启用域名白名单前，需独立出口防火墙保护私网和元数据；该标志仅确认前置部署。
# SANDBOX_CUBE_EGRESS_GUARD=true
