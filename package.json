{
  "name": "tao-agent",
  "version": "0.1.0",
  "private": true,
  "description": "面向高校服务机构与传统制造业的通用 AI 办公 Agent 平台",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "vendor/pi/agent",
    "vendor/pi/ai",
    "vendor/pi/chord",
    "vendor/pi/telemetry",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-packages.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "test": "vitest --run",
    "test:vendor": "node scripts/test-vendor.mjs",
    "spike": "vitest --run --config vitest.spikes.config.ts",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run check:boundaries && npm run test && npm run spike"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "shx": "^0.4.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
